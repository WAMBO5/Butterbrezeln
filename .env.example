# Certivity: copy to .env in the repository root (git-ignored) and fill in. Never commit a real key.
# Read by both approaches (they find this file from their folder) and by the product (./certivity ui).
# Demo mode works without any of this; the "Real" switch in the UI needs the key and the two models.

# --- LLM: needed for real runs ---
ANTHROPIC_API_KEY=                        # your key from console.anthropic.com; never printed or logged
ANTHROPIC_MODEL=claude-sonnet-5-5         # judgment tier: product analysis, scoping, matching
ANTHROPIC_MODEL_FAST=claude-haiku-5-5     # fast tier: obligation extraction, checks
ANTHROPIC_MODEL_REVIEW=                   # optional; defaults to ANTHROPIC_MODEL
ANTHROPIC_MODEL_MATCH=                    # optional; matcher and match reviewer, defaults to ANTHROPIC_MODEL

# --- pipeline runs ---
CERTIVITY_TEAM_ID=                        # written into submission.json
CERTIVITY_MAX_COST_USD=5                  # budget guard per CLI run; a run from the UI uses PIPELINE_MAX_COST_USD
CERTIVITY_MAX_RETRIES=2                   # verification loop limit
CERTIVITY_CONCURRENCY=6                   # parallel model calls
CERTIVITY_INCLUDE_UNCERTAIN=true          # keep requirements whose applicability is uncertain (F2 rewards recall)
CERTIVITY_DATA_DIR=data                   # relative to the approach folder, which links to data/<approach>/
CERTIVITY_RETENTION_DAYS=183              # run records kept at least this long (AI Act Art. 12)

# --- the product (./certivity ui) ---
PIPELINE_APPROACH=general-approach        # the approach whose pipeline runs start from the UI
PIPELINE_MAX_COST_USD=12                  # budget of a real run started from the UI (a full rear-lamp run is about $6.50)
# PIPELINE_FAKE_LLM=1                     # demo model only, e.g. for a public demo (same as ./certivity ui --demo)
