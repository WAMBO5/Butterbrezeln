---
import "../styles/global.css";

interface Props {
  title: string;
  current?: "start" | "run" | "requirements" | "review" | "ship-plan";
}
const { title, current = "start" } = Astro.props;
const tabs = [
  { key: "run", href: "/run", label: "Trace" },
  { key: "requirements", href: "/requirements", label: "Requirements" },
  { key: "review", href: "/review", label: "Review" },
  { key: "ship-plan", href: "/ship-plan", label: "Ship plan" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap" rel="stylesheet" />
    <title>{title} – Certivity</title>
  </head>
  <body>
    <header class="masthead">
      <a class="brand" href="/" aria-label="Certivity, start a run">
        <svg viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="17" fill="none" stroke="currentColor" stroke-width="3" /><text x="20" y="27" text-anchor="middle" font-size="19" font-weight="800" fill="currentColor" font-family="Archivo, sans-serif">C</text></svg>
        Certivity
      </a>
      {current !== "start" && (
        <nav class="runnav" aria-label="This run">
          {tabs.map((t) => (
            <a href={t.href} data-run-link aria-current={t.key === current ? "page" : undefined}>{t.label}</a>
          ))}
        </nav>
      )}
      <span class="run-ref" data-run-ref></span>
    </header>
    <div class="stamp" data-draft-stamp hidden><span data-draft-text>Unreviewed AI draft — not for compliance use</span></div>
    <main>
      <slot />
    </main>
    <script>
      const id = new URLSearchParams(window.location.search).get("id");
      if (id) {
        document.querySelectorAll<HTMLAnchorElement>("[data-run-link]").forEach((a) => {
          a.href = `${a.pathname}?id=${encodeURIComponent(id)}`;
        });
        const ref = document.querySelector("[data-run-ref]");
        if (ref) ref.textContent = id;
      }
    </script>
  </body>
</html>
