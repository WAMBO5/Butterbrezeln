---
import Base from "../layouts/Base.astro";
---
<Base title="Run" current="run">
  <div class="page-head">
    <div>
      <h1 id="title">Run</h1>
      <p id="subtitle">Loading the run…</p>
    </div>
    <div class="row" id="actions"></div>
  </div>

  <section class="sheet" aria-labelledby="scope-h">
    <div class="row" style="justify-content: space-between">
      <h2 id="scope-h">From 56 regulations to the requirements</h2>
      <span class="quiet" id="scope-legend"></span>
    </div>
    <p class="quiet" style="margin: 0.4rem 0 1rem">Each cell is one regulation of the corpus. Filled cells apply to this component; amber ones are uncertain. Select a cell to see why.</p>
    <div class="regpanel" id="regpanel"><p class="quiet">The regulations appear once the scope is decided.</p></div>
    <div class="decision-detail" id="decision-detail" aria-live="polite"></div>
    <div class="chainbar" id="chainbar"></div>
  </section>

  <div class="grid-2" style="margin-top: 1.5rem">
    <section class="sheet">
      <h2>Agent trace</h2>
      <p class="quiet" style="margin: 0.4rem 0 0.5rem">Each step runs in this order. Producers are checked by code and by a verifier; retries and open issues show here.</p>
      <ol class="steps" id="steps"></ol>
    </section>
    <aside class="stack">
      <section class="sheet stack" id="score-box" hidden>
        <h2>Score on the worked example</h2>
        <div id="score"></div>
      </section>
      <section class="sheet stack">
        <h2>Checks</h2>
        <div id="checks"></div>
      </section>
      <section class="sheet stack">
        <h2>Cost</h2>
        <div id="cost"></div>
      </section>
    </aside>
  </div>
</Base>

<script>
  import { api, runId, type LedgerRecord, type Run } from "../lib/api";
  import { $, chip, draftStamp, h, message, pct, tokens, usd } from "../lib/ui";

  const STEPS: { key: string; title: string; agents: string[] }[] = [
    { key: "load_case", title: "Read the spec and drawings", agents: [] },
    { key: "analyze", title: "Describe the product", agents: ["product_analyst", "profile_verifier"] },
    { key: "scope", title: "Choose regulations and sections", agents: ["scope_narrower", "recall_auditor"] },
    { key: "collect", title: "Collect candidate provisions", agents: [] },
    { key: "extract", title: "Extract obligations", agents: ["obligation_extractor", "extraction_verifier"] },
    { key: "match", title: "Match obligations to parts", agents: ["requirement_matcher", "match_reviewer"] },
    { key: "assemble", title: "Assemble, check citations, audit", agents: ["output_auditor"] },
    { key: "markets", title: "Markets and ship plan", agents: ["synergy_advisor", "grounding_verifier"] },
    { key: "finalize", title: "Validate and export", agents: [] },
  ];
  const LOOPS: Record<string, string> = {
    product_profile: "analyze", scope_plan: "scope", obligation_extraction: "extract", requirement_match: "match", ship_plan: "markets",
  };
  type AgentStat = { calls: number; running: number; errors: number; input: number; output: number; cost: number; lastError?: string };
  const stats: Record<string, AgentStat> = {};
  let activeStep: string | null = null;
  let loops: Record<string, { n: number; unresolved: number; retries: number }> = {};
  let run: Run | null = null;

  const id = runId();
  if (!id) message($("main"), "No run selected. Start one from the start page.", "error");

  function stat(agent: string): AgentStat {
    return (stats[agent] ??= { calls: 0, running: 0, errors: 0, input: 0, output: 0, cost: 0 });
  }

  function renderSteps() {
    const doneIndex = run?.step ? STEPS.findIndex((s) => s.key === run!.step) : -1;
    $("#steps").replaceChildren(...STEPS.map((s, i) => {
      const state = i <= doneIndex ? "done" : (s.key === activeStep || (run?.status === "running" && i === doneIndex + 1)) ? "active" : "pending";
      const lines = s.agents.filter((a) => stats[a]).map((a) => {
        const st = stats[a];
        return h("div", { class: "agent-line" }, h("strong", {}, a),
          h("span", {}, `${st.calls} call${st.calls === 1 ? "" : "s"}${st.running ? `, ${st.running} running` : ""}`),
          h("span", {}, `${tokens(st.input)} in / ${tokens(st.output)} out`), h("span", {}, usd(st.cost)),
          st.errors ? h("span", { class: "loop-note", title: st.lastError }, `${st.errors} failed or blocked`) : null);
      });
      const loopKey = Object.keys(LOOPS).find((k) => LOOPS[k] === s.key);
      const loop = loopKey ? loops[loopKey] : undefined;
      const loopLine = loop ? h("div", { class: "agent-line" },
        h("span", {}, `${loop.n} verified item${loop.n === 1 ? "" : "s"}`),
        h("span", {}, `${loop.retries} retr${loop.retries === 1 ? "y" : "ies"} after gate or verifier issues`),
        loop.unresolved ? h("span", { class: "loop-note" }, `${loop.unresolved} unresolved, kept as uncertain`) : h("span", {}, "all resolved")) : null;
      return h("li", { "data-state": state },
        h("div", {}, h("div", { class: "step-title" }, s.title)),
        h("div", {}, state === "active" ? chip("running") : state === "done" ? h("span", { class: "quiet" }, "done") : ""),
        s.agents.length || loopLine ? h("div", { class: "agents" }, ...lines, loopLine) : null);
    }));
  }

  function renderScope() {
    const panel = $("#regpanel");
    const decisions = run?.plan?.decisions ?? [];
    if (!decisions.length) return;
    const sorted = [...decisions].sort((a, b) => a.regulation.localeCompare(b.regulation, "en", { numeric: true }));
    const kept = sorted.filter((d) => d.state !== "not_applicable");
    $("#scope-legend").textContent = `${kept.length} of ${sorted.length} apply`;
    panel.replaceChildren(...sorted.map((d) => {
      const cell = h("button", { class: "regcell", type: "button", "data-state": d.state, "aria-pressed": "false",
        title: `${d.regulation}: ${d.state.replace("_", " ")}` }, d.regulation.replace("UN ", ""));
      cell.addEventListener("click", () => {
        panel.querySelectorAll(".regcell").forEach((c) => c.setAttribute("aria-pressed", "false"));
        cell.setAttribute("aria-pressed", "true");
        const sections = new Set(d.sections.flatMap((s) => s.section_ids.map((x) => x.split("#")[1])));
        $("#decision-detail").replaceChildren(h("p", {}, h("strong", {}, `${d.regulation} ${d.version_label} `), chip(d.state), " ",
          d.reason, sections.size ? h("span", { class: "quiet" }, ` Sections: ${[...sections].join(", ")}.`) : ""));
      });
      return cell;
    }));
  }

  function renderChain() {
    const c = run?.stage_counts ?? {};
    const items: [string, string][] = [
      [String(c.kept_regulations ?? "–"), "regulations apply"], [String(c.sections ?? "–"), "sections chosen"],
      [String(c.candidate_provisions ?? "–"), "candidate provisions"], [String(c.obligations ?? "–"), "obligations extracted"],
      [String(c.requirements ?? run?.requirements.length ?? "–"), "requirements"],
    ];
    $("#chainbar").replaceChildren(...items.map(([n, label]) => h("div", {}, h("strong", {}, n), h("span", { class: "quiet" }, label))));
  }

  function renderSide() {
    if (!run) return;
    const checks = $("#checks");
    const rows: HTMLElement[] = [];
    rows.push(h("p", {}, run.validation_problems.length ? `validate.py found ${run.validation_problems.length} problems.` :
      run.status === "done" ? "The submission passes the challenge's validate.py." : "Validation runs at the end."));
    if (run.partial) rows.push(h("p", { class: "message message-error" }, "Partial run: the budget was reached, so later items are flagged as uncertain."));
    if (run.error) rows.push(h("p", { class: "message message-error" }, run.error));
    if (run.give_ups.length) rows.push(h("div", {}, h("strong", {}, "Give-ups"), h("ul", {}, ...run.give_ups.map((g) => h("li", {}, g)))));
    if (run.missing_texts.length) rows.push(h("p", {}, `Missing regulation texts: ${run.missing_texts.join(", ")}.`));
    if (run.open_items.length) rows.push(h("p", {}, `${run.open_items.length} items need a reviewer's decision before sign-off.`));
    checks.replaceChildren(...rows);
    const per = run.cost.per_agent ?? {};
    $("#cost").replaceChildren(h("p", {}, `${usd(run.cost.spent_usd)} spent of a ${usd(run.cost.max_cost_usd)} budget.`),
      h("table", {}, h("thead", {}, h("tr", {}, h("th", {}, "Agent"), h("th", { class: "num" }, "Calls"), h("th", { class: "num" }, "Cost"))),
        h("tbody", {}, ...Object.entries(per).sort((a, b) => b[1].cost_usd - a[1].cost_usd).map(([name, r]) =>
          h("tr", {}, h("td", {}, name, h("br"), h("small", {}, r.model)), h("td", { class: "num" }, r.calls), h("td", { class: "num" }, usd(r.cost_usd)))))));
    if (run.score) {
      $("#score-box").hidden = false;
      $("#score").replaceChildren(h("table", {},
        h("thead", {}, h("tr", {}, h("th", {}, "Level"), h("th", { class: "num" }, "Precision"), h("th", { class: "num" }, "Recall"), h("th", { class: "num" }, "F1"))),
        h("tbody", {}, ...Object.entries(run.score).map(([level, s]) => h("tr", {}, h("td", {}, level.replace("_level", "")),
          h("td", { class: "num" }, pct(s.precision)), h("td", { class: "num" }, pct(s.recall)), h("td", { class: "num" }, pct(s.f1)))))),
        h("small", {}, "Offline score from the challenge's score_local.py: regulation and page level. The requirement level is judged on the platform."));
    }
  }

  function renderHead() {
    if (!run) return;
    $("#title").textContent = run.case_id;
    $("#subtitle").replaceChildren(chip(run.status), " ", `${run.mode === "assisted" ? "Assisted" : "Benchmark"} run started ${new Date(run.started_at).toLocaleString()}.`,
      run.checkpoint ? ` Waiting for your review at ${run.checkpoint.replace("_", ", ")}.` : "");
    const actions: HTMLElement[] = [];
    if (run.status === "awaiting_review") actions.push(h("a", { class: "button", href: `/review?id=${encodeURIComponent(run.run_id)}` }, "Review now"));
    if (run.requirements.length) actions.push(h("a", { class: "button secondary", href: `/requirements?id=${encodeURIComponent(run.run_id)}` }, `Open ${run.requirements.length} requirements`));
    if (run.status === "done") {
      actions.push(h("a", { class: "button secondary", href: api.url(`/runs/${encodeURIComponent(run.run_id)}/submission.json`) }, "Download submission"));
      actions.push(h("a", { class: "button secondary", href: api.url(`/runs/${encodeURIComponent(run.run_id)}/report`) }, "Report"));
    }
    $("#actions").replaceChildren(...actions);
    draftStamp(run.label);
  }

  async function refreshLedger() {
    if (!id) return;
    const records: LedgerRecord[] = await api.ledger(id);
    loops = {};
    for (const r of records) {
      if (r.kind !== "loop_result") continue;
      const l = (loops[r.actor] ??= { n: 0, unresolved: 0, retries: 0 });
      l.n += 1;
      l.retries += Math.max(0, (r.meta.attempts ?? 1) - 1);
      if (!r.meta.resolved) l.unresolved += 1;
    }
  }

  async function refresh() {
    if (!id) return;
    try {
      run = await api.run(id);
    } catch (e) {
      return message($("main"), `This run could not be loaded: ${(e as Error).message}`, "error");
    }
    renderHead(); renderScope(); renderChain(); renderSide(); renderSteps();
    if (run.status === "running") setTimeout(refresh, 2500);
  }

  if (id) {
    const source = api.events(id);
    source.onmessage = (msg) => {
      const e = JSON.parse(msg.data);
      if (e.event === "step_start") activeStep = e.step;
      if (e.event === "step_end") activeStep = null;
      if (e.event === "agent_start") { const s = stat(e.agent); s.calls += 1; s.running += 1; }
      if (e.event === "agent_end") { const s = stat(e.agent); s.running = Math.max(0, s.running - 1); s.input += (e.usage?.input ?? 0) + (e.usage?.cache_read ?? 0) + (e.usage?.cache_write ?? 0); s.output += e.usage?.output ?? 0; s.cost += e.cost_usd ?? 0; }
      if (e.event === "agent_error" || e.event === "agent_blocked") { const s = stat(e.agent); s.running = Math.max(0, s.running - 1); s.errors += 1; s.lastError = e.error; }
      if (e.event === "status") { source.close(); refreshLedger().then(refresh); }
      renderSteps();
    };
    source.onerror = () => source.close();
    refreshLedger().catch(() => undefined).finally(refresh);
    setInterval(() => { if (run?.status === "running") refreshLedger().then(renderSteps).catch(() => undefined); }, 6000);
  }
</script>
