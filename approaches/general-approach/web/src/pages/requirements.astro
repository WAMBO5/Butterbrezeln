---
import Base from "../layouts/Base.astro";
---
<Base title="Requirements" current="requirements">
  <div class="page-head">
    <div>
      <h1>Requirements</h1>
      <p id="summary">Loading…</p>
    </div>
    <div class="row" id="downloads"></div>
  </div>

  <div class="filters" role="search">
    <div>
      <label for="q">Search the text</label>
      <input type="text" id="q" placeholder="marking, colour, 250 mm…" />
    </div>
    <div>
      <label for="f-reg">Regulation</label>
      <select id="f-reg"><option value="">All</option></select>
    </div>
    <div>
      <label for="f-state">Decision</label>
      <select id="f-state"><option value="">All</option><option value="applicable">Applies</option><option value="uncertain">Uncertain</option></select>
    </div>
    <div>
      <label for="f-evidence">Evidence</label>
      <select id="f-evidence"><option value="">All</option><option value="met">Met</option><option value="not_met">Not met</option><option value="evidence_needed">Evidence needed</option></select>
    </div>
  </div>

  <div id="list"></div>

  <aside class="panel" id="panel" aria-labelledby="panel-title" aria-hidden="true">
    <header>
      <div>
        <h3 id="panel-title">Source</h3>
        <small id="panel-sub"></small>
      </div>
      <button class="button secondary small" type="button" id="panel-close">Close</button>
    </header>
    <div class="panel-body" id="panel-body"></div>
  </aside>
</Base>

<script>
  import { api, runId, type Requirement, type Run } from "../lib/api";
  import { $, chip, citation, draftStamp, h, message } from "../lib/ui";

  const id = runId();
  let run: Run | null = null;
  const STEP_NAMES: Record<string, string> = {
    part: "Part of the product", fact: "Fact from your inputs", scope_decision: "Why the regulation applies",
    provision: "Provision in the regulation", obligation: "Obligation extracted from it", match_decision: "Decision for this part",
    human_action: "Reviewer action",
  };

  const panel = $("#panel");
  function openPanel(title: string, sub: string, body: Node[]) {
    $("#panel-title").textContent = title;
    $("#panel-sub").textContent = sub;
    $("#panel-body").replaceChildren(...body);
    panel.setAttribute("data-open", "");
    panel.setAttribute("aria-hidden", "false");
    $<HTMLButtonElement>("#panel-close").focus();
  }
  function closePanel() { panel.removeAttribute("data-open"); panel.setAttribute("aria-hidden", "true"); }
  $("#panel-close").addEventListener("click", closePanel);
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") closePanel(); });

  async function showSource(r: Requirement, page = r.source.page) {
    const quote = run?.quotes[r.id];
    try {
      const p = await api.page(r.source.regulation, r.source.version, page, quote);
      const doc = h("div", { class: "document" });
      if (p.highlight) {
        const [a, b] = p.highlight;
        doc.append(p.text.slice(0, a), h("mark", {}, p.text.slice(a, b)), p.text.slice(b));
      } else doc.append(p.text);
      const nav = h("div", { class: "row", style: "margin-bottom: 0.9rem" },
        h("button", { class: "button secondary small", type: "button", disabled: page <= 1, onclick: () => showSource(r, page - 1) }, "Previous page"),
        h("span", { class: "quiet" }, `Page ${page} of ${p.pages}`),
        h("button", { class: "button secondary small", type: "button", disabled: page >= p.pages, onclick: () => showSource(r, page + 1) }, "Next page"));
      openPanel(`${r.source.regulation}, page ${page}`, `Version ${r.source.version}${r.source.paragraph ? `, paragraph ${r.source.paragraph}` : ""}. ${p.highlight ? "The highlighted text is what the requirement rests on." : page === r.source.page ? "The quote spans a page break; see the neighbouring page." : ""}`,
        [nav, doc]);
      doc.querySelector("mark")?.scrollIntoView({ block: "center" });
    } catch (e) {
      openPanel("Source", "", [h("p", { class: "message message-error" }, `The page could not be loaded: ${(e as Error).message}`)]);
    }
  }

  async function showLineage(r: Requirement) {
    try {
      const lin = await api.lineage(id!, r.id);
      openPanel(`Why is ${r.id} here?`, "Every step from your product to the regulation text.", [
        h("ol", { class: "chain" }, ...lin.links.map((l) => h("li", {},
          h("div", { class: "step-name" }, STEP_NAMES[l.step] ?? l.step), h("div", {}, l.summary), h("div", { class: "ref" }, l.ref)))),
        h("button", { class: "button secondary small", type: "button", onclick: () => showSource(r) }, "Open the source page"),
      ]);
    } catch (e) {
      openPanel("Lineage", "", [h("p", { class: "message message-error" }, `The lineage could not be loaded: ${(e as Error).message}`)]);
    }
  }

  function row(r: Requirement) {
    const test = r.test_case ? h("details", {}, h("summary", {}, "How to test"), h("p", {}, r.test_case)) : null;
    return h("article", { class: "req" },
      h("div", { class: "rid" }, r.id),
      h("div", {}, h("p", {}, r.text)),
      h("div", { class: "chips" }, chip(r.state, r.reason), chip(r.evidence_status)),
      h("div", { class: "meta" },
        h("button", { class: "linklike", type: "button", onclick: () => showSource(r) }, citation(r.source.regulation, r.source.page, r.source.paragraph)),
        h("button", { class: "linklike", type: "button", onclick: () => showLineage(r) }, "Why is this here?"),
        h("span", { class: "ai-tag" }, "AI-drafted"), test));
  }

  function render() {
    if (!run) return;
    const q = $<HTMLInputElement>("#q").value.toLowerCase();
    const reg = $<HTMLSelectElement>("#f-reg").value;
    const state = $<HTMLSelectElement>("#f-state").value;
    const ev = $<HTMLSelectElement>("#f-evidence").value;
    const reqs = run.requirements.filter((r) => (!q || r.text.toLowerCase().includes(q)) && (!reg || r.source.regulation === reg)
      && (!state || r.state === state) && (!ev || r.evidence_status === ev));
    const parts = run.profile?.parts ?? [];
    const allIds = parts.map((p) => p.part_id);
    const everyPart = (r: Requirement) => allIds.length > 1 && allIds.every((p) => r.part_ids.includes(p));
    const groups: { title: string; note: string; items: Requirement[] }[] = [];
    const shared = reqs.filter(everyPart);
    if (shared.length) groups.push({ title: "Every part", note: "These bind the whole product.", items: shared });
    for (const p of parts) {
      const items = reqs.filter((r) => !everyPart(r) && r.part_ids.includes(p.part_id));
      if (items.length) groups.push({ title: p.name, note: p.functions.join(", "), items });
    }
    const list = $("#list");
    if (!groups.length) return message(list, run.requirements.length ? "No requirement matches these filters." : "This run has no requirements yet.");
    list.replaceChildren(...groups.map((g) => {
      const byReg = new Map<string, Requirement[]>();
      for (const r of g.items) byReg.set(r.source.regulation, [...(byReg.get(r.source.regulation) ?? []), r]);
      return h("section", { class: "req-group" }, h("h2", {}, g.title), h("p", { class: "quiet" }, `${g.items.length} requirements. ${g.note}`),
        ...[...byReg.entries()].map(([name, items]) => h("div", { class: "reg-block" },
          h("h3", {}, name, h("span", { class: "quiet" }, `${items.length}`)), ...items.map(row))));
    }));
  }

  async function load() {
    if (!id) return message($("#list"), "No run selected.", "error");
    try {
      run = await api.run(id);
    } catch (e) {
      return message($("#list"), `This run could not be loaded: ${(e as Error).message}`, "error");
    }
    draftStamp(run.label);
    const regs = [...new Set(run.requirements.map((r) => r.source.regulation))].sort();
    $("#f-reg").append(...regs.map((r) => h("option", { value: r }, r)));
    const uncertain = run.requirements.filter((r) => r.state === "uncertain").length;
    $("#summary").textContent = `${run.requirements.length} requirements from ${regs.length} regulations for ${run.case_id}` +
      `${uncertain ? `, ${uncertain} of them uncertain` : ""}. Review status: ${run.review_status}.`;
    if (run.status === "done") $("#downloads").replaceChildren(h("a", { class: "button secondary", href: api.url(`/runs/${encodeURIComponent(id)}/submission.json`) }, "Download submission"));
    render();
  }

  ["#q", "#f-reg", "#f-state", "#f-evidence"].forEach((sel) => $(sel).addEventListener("input", render));
  load();
</script>
