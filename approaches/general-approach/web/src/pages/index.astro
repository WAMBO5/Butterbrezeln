---
import Base from "../layouts/Base.astro";
---
<Base title="Start a run" current="start">
  <div class="page-head">
    <div>
      <h1>Which UN Regulations does this part have to meet?</h1>
      <p>Give Certivity a component's specification or exploded view. It decides which of the 56 regulations apply, and returns every engineering requirement with the regulation, version, page and paragraph it comes from.</p>
    </div>
  </div>

  <div class="grid-2">
    <form id="start" class="stack" novalidate>
      <section class="sheet stack">
        <fieldset>
          <legend>Component</legend>
          <div id="cases"><p class="quiet">Loading cases…</p></div>
          <label class="choice" for="case-upload">
            <input type="radio" name="case" id="case-upload" value="__upload" />
            <strong>Upload your own</strong>
            <span>A spec as Markdown (.md) and/or drawings as PNG or JPG. Either one is enough.</span>
          </label>
          <div id="upload-fields" class="stack" hidden style="margin-top: 0.75rem">
            <div>
              <label for="upload-name">Name of the component</label>
              <input type="text" id="upload-name" placeholder="front-bumper" />
            </div>
            <div>
              <label for="upload-files">Files</label>
              <input type="file" id="upload-files" multiple accept=".md,.png,.jpg,.jpeg" />
            </div>
          </div>
        </fieldset>
      </section>

      <section class="sheet stack">
        <fieldset>
          <legend>Markets</legend>
          <p class="banner">The markets are illustrative samples with made-up names, not real national law. They only show how the requirements split by market.</p>
          <div id="markets" class="stack" style="margin-top: 0.75rem"><p class="quiet">Loading markets…</p></div>
        </fieldset>
      </section>

      <section class="sheet stack">
        <fieldset>
          <legend>Mode</legend>
          <label class="choice">
            <input type="radio" name="mode" value="benchmark" checked />
            <strong>Benchmark</strong>
            <span>Runs straight through with no pauses. Everything it produces is labelled an unreviewed AI draft.</span>
          </label>
          <label class="choice">
            <input type="radio" name="mode" value="assisted" />
            <strong>Assisted</strong>
            <span>Pauses for your review of the product profile, the chosen regulations and the final requirements, and ends with your sign-off.</span>
          </label>
        </fieldset>
        <div class="row">
          <button class="button" type="submit" id="start-button">Start run</button>
          <span class="quiet" id="cost-note">Each run calls LLM and costs money; the budget guard stops it at the configured limit.</span>
        </div>
        <div id="start-message"></div>
      </section>
    </form>

    <aside class="stack">
      <section class="sheet stack">
        <h2>Using this responsibly</h2>
        <p>Certivity drafts requirements with AI. Treat the output as a starting point for an engineer, not as a compliance decision.</p>
        <ul class="stack" style="padding-left: 1.1rem; margin: 0">
          <li>It knows the 56 UN Regulations of the challenge corpus and nothing else: no national law, no standards.</li>
          <li>Every requirement cites its source page. Open the citation and read the regulation before you rely on it.</li>
          <li>Evidence is judged from your spec only. "Evidence needed" means the spec does not show it, not that the part fails.</li>
          <li>Uncertain items and any disagreement between agents are kept and marked, never hidden. Resolve them in the review.</li>
          <li>Only an assisted run with a named sign-off counts as reviewed.</li>
        </ul>
      </section>
      <section class="sheet stack">
        <h2>Recent runs</h2>
        <div id="runs"><p class="quiet">Loading…</p></div>
      </section>
    </aside>
  </div>
</Base>

<script>
  import { api, type CaseItem } from "../lib/api";
  import { $, chip, h, message, usd } from "../lib/ui";

  const casesBox = $("#cases");
  const uploadFields = $("#upload-fields");

  function caseChoice(c: CaseItem, checked: boolean) {
    return h("label", { class: "choice" },
      h("input", { type: "radio", name: "case", value: c.case_dir, checked }),
      h("strong", {}, c.case_id),
      h("span", {}, `${c.files.join(", ")}${c.has_expected ? ". Has an expected answer, so the run is scored." : ""}`));
  }

  api.cases().then((cases) => {
    casesBox.replaceChildren(...cases.map((c, i) => caseChoice(c, i === 0)));
    if (!cases.length) message(casesBox, "No challenge cases found. Upload a spec or drawing instead.");
  }).catch((e) => message(casesBox, `Cases could not be loaded: ${e.message}. Is the service running (uv run certivity serve)?`, "error"));

  document.addEventListener("change", (e) => {
    const t = e.target as HTMLInputElement;
    if (t.name === "case") uploadFields.hidden = t.value !== "__upload";
  });

  const marketsBox = $("#markets");
  api.markets().then((markets) => {
    marketsBox.replaceChildren(...markets.map((m) =>
      h("label", { class: "choice" },
        h("input", { type: "checkbox", name: "market", value: m.market_id }),
        h("strong", {}, m.name),
        h("span", {}, `${m.rules.filter((r) => r.status !== "not_applied").length} regulations applied${m.outside_corpus.length ? ", plus rules outside the corpus" : ""}`))));
    if (!markets.length) message(marketsBox, "No market profiles are configured.");
  }).catch(() => message(marketsBox, "The market layer is not available on this server; the run covers the UN requirements only."));

  const runsBox = $("#runs");
  api.runs().then((runs) => {
    if (!runs.length) return message(runsBox, "No runs yet. Start one on the left.");
    runsBox.replaceChildren(h("table", {},
      h("thead", {}, h("tr", {}, h("th", {}, "Case"), h("th", {}, "Status"), h("th", { class: "num" }, "Requirements"), h("th", { class: "num" }, "Cost"))),
      h("tbody", {}, ...runs.slice(0, 12).map((r) => h("tr", {},
        h("td", {}, h("a", { href: `/run?id=${encodeURIComponent(r.run_id)}` }, r.case_id), h("br"), h("small", {}, new Date(r.started_at).toLocaleString())),
        h("td", {}, chip(r.status)),
        h("td", { class: "num" }, r.requirements),
        h("td", { class: "num" }, usd(r.cost_usd)))))));
  }).catch(() => message(runsBox, "Runs could not be loaded."));

  $("#start").addEventListener("submit", async (e) => {
    e.preventDefault();
    const out = $("#start-message");
    const button = $<HTMLButtonElement>("#start-button");
    const caseDir = (document.querySelector<HTMLInputElement>("input[name=case]:checked"))?.value;
    const mode = (document.querySelector<HTMLInputElement>("input[name=mode]:checked"))?.value ?? "benchmark";
    const markets = [...document.querySelectorAll<HTMLInputElement>("input[name=market]:checked")].map((m) => m.value);
    if (!caseDir) return message(out, "Choose a component or upload one.", "error");
    button.disabled = true;
    try {
      let runId: string;
      if (caseDir === "__upload") {
        const files = $<HTMLInputElement>("#upload-files").files;
        if (!files || !files.length) throw new Error("Add a spec (.md) or a drawing (.png, .jpg) to upload.");
        const form = new FormData();
        [...files].forEach((f) => form.append("files", f));
        form.append("case_id", $<HTMLInputElement>("#upload-name").value || "upload");
        form.append("mode", mode);
        form.append("markets", markets.join(","));
        runId = (await api.upload(form)).run_id;
      } else {
        runId = (await api.start(caseDir, markets, mode)).run_id;
      }
      window.location.href = `/run?id=${encodeURIComponent(runId)}`;
    } catch (err) {
      message(out, `The run did not start: ${(err as Error).message}`, "error");
      button.disabled = false;
    }
  });
</script>
